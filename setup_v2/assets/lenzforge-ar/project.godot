; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LenzForge AR Demo"
config/description="LenzForge facial tracking demonstration using VID1 and LMK1 ring buffers"
config/version="1.0.0"
run/main_scene="res://scenes/ui/lenzforge_main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

LenzForgeManager="*res://autoload/lenzforge_manager.gd"
VideoService="*res://autoload/video_service.gd"
LandmarkService="*res://autoload/landmark_service.gd"
ErrorBus="*res://autoload/error_bus.gd"
ThemeManager="*res://scripts/managers/ThemeManager.gd"
SettingsManager="*res://scripts/managers/SettingsManager.gd"
CustomizationManager="*res://scripts/managers/CustomizationManager.gd"
KeyboardManager="*res://scripts/managers/KeyboardManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2

[editor_plugins]

enabled=PackedStringArray()

[gdextension]

extensions=PackedStringArray("res://gdextension/lenzforge.gdextension")

[rendering]

renderer/rendering_method.mobile="forward_plus"

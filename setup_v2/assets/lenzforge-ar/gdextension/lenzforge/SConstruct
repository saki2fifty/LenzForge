#!/usr/bin/env python
import os
import sys

# Get target from command line (default: template_debug)
target = ARGUMENTS.get("target", "template_debug")

# Force GCC toolchain
env = Environment(tools=['mingw'])

# Project paths
project_root = os.path.abspath("../../../..")  # Up 4 levels: lenzforge -> gdextension -> LenzForge-AR -> workspace_v2 -> project root
godot_cpp_path = os.path.join(project_root, "buildtools", "godot-cpp")
mingw_path = os.path.join(project_root, "buildtools", "mingw", "bin")

# Platform-specific settings
if sys.platform == "win32" or os.name == "nt":
	# Compiler - must set these before other settings
	env["CXX"] = os.path.join(mingw_path, "g++.exe")
	env["CC"] = os.path.join(mingw_path, "gcc.exe")
	env["AR"] = os.path.join(mingw_path, "ar.exe")
	env["RANLIB"] = os.path.join(mingw_path, "ranlib.exe")
	
	# Compiler flags
	env.Append(CCFLAGS=["-std=c++17", "-O3", "-Wall"])
	env.Append(CPPDEFINES=["WINDOWS_ENABLED"])
	
	# Include paths
	env.Append(CPPPATH=[
		"src",
		os.path.join(godot_cpp_path, "include"),
		os.path.join(godot_cpp_path, "gen", "include"),
		os.path.join(godot_cpp_path, "gdextension")
	])
	
	# Library paths and libs (use correct library for target)
	env.Append(LIBPATH=[os.path.join(godot_cpp_path, "bin")])
	env.Append(LIBS=[f"godot-cpp.windows.{target}.x86_64"])
	
	# Windows API
	env.Append(LIBS=["kernel32", "user32"])
	
	# Linker flags for DLL
	env.Append(LINKFLAGS=["-shared", "-static-libgcc", "-static-libstdc++"])
	
	# Create bin directory
	bin_dir = "../bin"
	if not os.path.exists(bin_dir):
		os.makedirs(bin_dir)

# Source files
sources = Glob("src/*.cpp")

# Compile objects
objects = []
for src in sources:
	obj = env.Object(src)
	objects.extend(obj)

# Link DLL manually using Command (with target-specific name)
dll_path = f"../bin/lenzforge.windows.{target}.x86_64.dll"

def link_dll(target, source, env):
	import subprocess
	gpp = os.path.join(mingw_path, "g++.exe")
	build_target = ARGUMENTS.get("target", "template_debug")
	godot_lib = os.path.join(godot_cpp_path, "bin", f"libgodot-cpp.windows.{build_target}.x86_64.a")
	
	cmd = [
		gpp,
		"-shared",
		"-static-libgcc",
		"-static-libstdc++",
		"-o", str(target[0])
	]
	cmd.extend([str(s) for s in source])
	cmd.extend([godot_lib, "-lkernel32", "-luser32"])
	
	print("Linking:", " ".join(cmd))
	result = subprocess.call(cmd)
	return result

dll = env.Command(dll_path, objects, link_dll)

Default(dll)

print("=" * 60)
print("Building LenzForge GDExtension")
print("=" * 60)
print(f"Target: {target}")
print(f"Output: {dll_path}")
print(f"Sources: {len(sources)} files")
print(f"godot-cpp: {godot_cpp_path}")
print(f"MinGW: {mingw_path}")
print("=" * 60)
